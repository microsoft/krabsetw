<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately empty. AutoGenerateBindingRedirects needs a configuration file to transform,
  but the redirects themselves are left to it rather than written out here: these sources are
  vendored into repositories that pin different versions of System.Memory and its
  dependencies, and a hardcoded version is both wrong there and reported as MSB3836.
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>
